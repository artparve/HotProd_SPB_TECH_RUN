# Optional local diagnostics; copy via `make config-init` and edit locally.
services:
  backend:
    ports:
      - "127.0.0.1:${LOCAL_BACKEND_PORT:-8000}:${BACKEND_PORT:-8000}"
  mongo:
    ports:
      - "127.0.0.1:${LOCAL_MONGO_PORT:-27017}:${MONGO_PORT:-27017}"
  llm:
    ports:
      - "127.0.0.1:${LOCAL_LLM_PORT:-8010}:${LLM_PORT:-8010}"
