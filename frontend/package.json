{
  "name": "repaircalc-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test && playwright test --config playwright.inspirations.config.ts",
    "test:e2e:inspirations": "playwright test --config playwright.inspirations.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@lucide/vue": "1.61.0",
    "decimal.js": "10.6.0",
    "markdown-it": "15.0.3",
    "vue": "3.5.44",
    "vue-router": "4.5.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "12.1.0",
    "@playwright/test": "1.64.1",
    "@types/markdown-it": "14.2.0",
    "@types/node": "22.13.4",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.4.6",
    "jsdom": "26.0.0",
    "prettier": "3.9.10",
    "sass": "1.83.4",
    "typescript": "5.7.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue-tsc": "2.2.0"
  }
}
