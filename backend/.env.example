# Local configuration example; deployment uses process environment variables.
# The local profile loads backend/.env.local when started from backend/.
# Copy this example there and supply your local DB password, or use run-local.cmd.
# Deploy never loads .env.local.
SPRING_PROFILES_ACTIVE=local
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8000

# Local PostgreSQL only; choose a local password before running the application.
# Deploy requires explicit DB_URL and DB_USER too.
DB_URL=jdbc:postgresql://127.0.0.1:55432/repaircalc
DB_USER=repaircalc
DB_PASSWORD=
