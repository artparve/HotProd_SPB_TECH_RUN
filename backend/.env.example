# Set these variables in the process environment before starting Java.
# Spring Boot does not load this file automatically.
SPRING_PROFILES_ACTIVE=local
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8000

# Local PostgreSQL only; choose a local password before running the application.
# Deploy requires explicit DB_URL and DB_USER too.
DB_URL=jdbc:postgresql://127.0.0.1:55432/repaircalc
DB_USER=repaircalc
DB_PASSWORD=
