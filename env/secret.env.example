# Copy to env/secret.env (make init-config does not overwrite existing files).
# Never commit secret.env or put credentials in env/.env / VITE_* variables.
# Set the existing database password; changing this does not rotate a volume's password.
DB_PASSWORD=

# Generate with: python3 backend/scripts/admin-password-hash.py
# Keep its single quotes so Compose does not interpolate the literal $ characters.
# Leave empty to disable admin access together with an empty ADMIN_USERNAME in .env.
ADMIN_PASSWORD_HASH=
