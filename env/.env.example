# Single local configuration for Vite, project scripts and Docker Compose.
# Copy to env/.env with: make init-config

# Public frontend build settings; NEVER put secrets in VITE_* variables.
VITE_DATA_MODE=api
VITE_API_BASE_URL=/api/v1

# Backend as seen by the Vite dev server running on the host.
API_UPSTREAM=http://127.0.0.1:8000
# Legacy setting for manual frontend-only deployment; full Compose uses backend:8000.
DOCKER_API_UPSTREAM=http://host.docker.internal:8000

# Estimator as seen by the Vite dev server on the host.
ESTIMATION_UPSTREAM=http://127.0.0.1:8010
DOCKER_ESTIMATION_UPSTREAM=http://host.docker.internal:8010

FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=8080
IMAGE_TAG=local

# Full Docker stack uses API mode independently of the Vite dev server above.
COMPOSE_DATA_MODE=api
# Set a unique password before the first start. Existing volumes keep their password.
DB_PASSWORD=replace-with-your-local-password
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=gemma4:12b
OLLAMA_IMAGE_TAG=0.40.13
OLLAMA_CPU_LIMIT=8.0
OLLAMA_NUM_THREADS=8

# Administrative catalog: generate a hash via backend/scripts/admin-password-hash.py.
# Paste the single-quoted ADMIN_PASSWORD_HASH line without removing its quotes ($ is literal).
# Empty credentials disable all administrative API routes (503).
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# HTTPS default. For a loopback-only HTTP stand explicitly set false.
ADMIN_COOKIE_SECURE=true
ADMIN_SESSION_SECONDS=1800
