# Shared non-secret defaults. Local files are never overwritten.
# Secrets belong in secret.env. Containers use internal URLs from Compose.
LOG_MAX_SIZE=10m
LOG_MAX_FILES=3
IMAGE_TAG=local
MAVEN_IMAGE=maven:3.9-eclipse-temurin-21
JAVA_IMAGE=eclipse-temurin:21-jre-jammy
BACKEND_ADDRESS=0.0.0.0
BACKEND_PORT=8000
MONGO_PORT=27017
MONGO_DATABASE=repaircalc
MONGO_REPLICA_SET=rs0
MONGO_USER=repaircalc
MONGO_SERVER_SELECTION_TIMEOUT_MS=3000
MONGO_CONNECT_TIMEOUT_MS=3000
MONGO_READ_TIMEOUT_MS=10000
ADMIN_USERNAME=
ADMIN_COOKIE_SECURE=true
ADMIN_SESSION_SECONDS=1800
ADMIN_BODY_MAX_BYTES=262144
LLM_PORT=8010
LLM_CONNECT_TIMEOUT_SECONDS=3
LLM_REQUEST_TIMEOUT_SECONDS=1260
LLM_RESPONSE_MAX_BYTES=1048576
CLASSIFICATION_ENABLED=true
CLASSIFICATION_MAX_ATTEMPTS=3
CLASSIFICATION_LEASE_MS=90000
CLASSIFICATION_HEARTBEAT_MS=20000
CLASSIFICATION_RETRY_MS=15000
CLASSIFICATION_POLL_MS=2000
IMAGE_MAX_BYTES=8388608
IMAGE_MAX_PIXELS=12000000
INSPIRATION_THUMBNAIL_SIZE=480
INSPIRATION_PAGE_LIMIT=24
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75
BACKEND_CPU_LIMIT=1.0
BACKEND_MEMORY_LIMIT=768m
BACKEND_TMP_LIMIT=128m
MONGO_IMAGE_TAG=8.0
MONGO_ROOT_USER=root
MONGO_CPU_LIMIT=1.0
MONGO_MEMORY_LIMIT=1g
HEALTH_INTERVAL=10s
HEALTH_TIMEOUT=5s
HEALTH_RETRIES=12
MONGO_INIT_TIMEOUT_MS=60000
BACKEND_START_PERIOD=60s
PYTHON_IMAGE=python:3.12-slim
LLM_ADDRESS=0.0.0.0
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=gemma4:12b
OLLAMA_TIMEOUT_SECONDS=600
OLLAMA_CONTEXT_LENGTH=16384
OLLAMA_NUM_PREDICT=4096
OLLAMA_NUM_THREADS=8
OLLAMA_RESPONSE_MAX_BYTES=2097152
LLM_CONCURRENCY=1
LLM_BODY_MAX_BYTES=12582912
LLM_SOCKET_TIMEOUT_SECONDS=30
LLM_CPU_LIMIT=1.0
LLM_MEMORY_LIMIT=512m
NODE_IMAGE=node:22-alpine
NGINX_IMAGE=nginx:1.28-alpine
FRONTEND_PORT=8080
API_CONNECT_TIMEOUT=3s
API_READ_TIMEOUT=1265s
API_MAX_BODY_SIZE=12m
DNS_RESOLVER=127.0.0.11
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PUBLIC_PORT=8080
FRONTEND_CPU_LIMIT=0.25
FRONTEND_MEMORY_LIMIT=128m
FRONTEND_TMP_LIMIT=32m
OLLAMA_IMAGE_TAG=0.40.13
OLLAMA_CPU_LIMIT=8.0
OLLAMA_MEMORY_LIMIT=12g
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_KEEP_ALIVE=60s
OLLAMA_CACHE_RAM=0
OLLAMA_CTX_CHECKPOINTS=0
VITE_DATA_MODE=api
VITE_API_BASE_URL=/api/v1
DEV_HOST=127.0.0.1
DEV_PORT=5173
DEV_PROXY_TIMEOUT_MS=1265000
SPRING_PROFILES_ACTIVE=local
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8000
MONGO_URI=mongodb://127.0.0.1:27017/repaircalc?replicaSet=rs0&directConnection=true
API_UPSTREAM=http://127.0.0.1:8000
LLM_SERVICE_URL=http://127.0.0.1:8010
LOCAL_OLLAMA_URL=http://127.0.0.1:11434
LOCAL_LLM_ADDRESS=127.0.0.1
LOCAL_BACKEND_PORT=8000
LOCAL_MONGO_PORT=27017
LOCAL_LLM_PORT=8010
DATA_DIR=data
