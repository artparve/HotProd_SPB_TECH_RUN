# Shared NON-SECRET settings for Vite, local Java/Python and Docker Compose.
# Copy to env/.env with: make init-config
# Credentials belong only in env/secret.env (see secret.env.example).

# Public frontend build settings; NEVER put secrets in VITE_* variables.
VITE_DATA_MODE=api
VITE_API_BASE_URL=/api/v1
DEV_HOST=127.0.0.1
DEV_PORT=5173

# Java running on the host. Containers explicitly override profile/address/DB_URL.
SPRING_PROFILES_ACTIVE=local
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8000
DB_NAME=repaircalc
DB_USER=repaircalc
DB_URL=jdbc:postgresql://127.0.0.1:55432/repaircalc
POSTGRES_HOST_PORT=55432
POSTGRES_IMAGE_TAG=17.11

# Backend as seen by the Vite dev server running on the host.
API_UPSTREAM=http://127.0.0.1:8000

# Estimator as seen by the Vite dev server on the host.
ESTIMATION_UPSTREAM=http://127.0.0.1:8010
ESTIMATOR_ADDRESS=127.0.0.1
ESTIMATOR_PORT=8010

FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=8080
IMAGE_TAG=local

# Full Docker stack uses API mode independently of the Vite dev server above.
COMPOSE_DATA_MODE=api
# Containers use OLLAMA_URL; local Python uses LOCAL_OLLAMA_URL instead.
OLLAMA_URL=http://ollama:11434
LOCAL_OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_PORT=11434
OLLAMA_MODEL=gemma4:12b
OLLAMA_IMAGE_TAG=0.40.13
OLLAMA_CPU_LIMIT=8.0
OLLAMA_MEMORY_LIMIT=12g
OLLAMA_NUM_THREADS=8

# Administrative catalog: generate a hash via backend/scripts/admin-password-hash.py.
# Save the hash in env/secret.env. Empty credentials disable admin routes (503).
ADMIN_USERNAME=
# HTTPS default. For a loopback-only HTTP stand explicitly set false.
ADMIN_COOKIE_SECURE=true
ADMIN_SESSION_SECONDS=1800
